 <Setting Name="OpenIDConnect::OICDProvider###Custom1" Required="0" Valid="0">
        <Description Translatable="1">OAuth2 OpenID Connect Client Profile. Provide at least your OAuth2 Client settings (client_id, client_secret), as
        well as your OIDC Provider's the well-known metadata discovery url (eg https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration)</Description>
        <Navigation>Core::Auth::OpenIDConnect</Navigation>
        <Value>
            <Hash>
                <Item Key="ClientSettings">
                    <Hash>
                        <Item Key="ClientID" ValueType="String">&lt;your_oauth_client_id&gt;</Item>
                        <Item Key="ClientSecret" ValueType="Password">&lt;your_oauth_client_secret&gt;</Item>
                    </Hash>
                </Item>
                <Item Key="ProviderSettings">
                    <Hash>
                        <Item Key="Name" ValueType="String">OIDCInternal1</Item>
                        <Item Key="OpenIDConfiguration" ValueType="String">&lt;your 'well-known' OIDC Provider metadata url.</Item>
                        <Item Key="TTL" ValueType="String">60 * 30</Item>
                        <Item Key="SSLOptions">
                            <Hash>
                                <Item Key="SSLCertificate" ValueType="String"></Item>
                                <Item Key="SSLKey" ValueType="String"></Item>
                                <Item Key="SSLPassword" ValueType="String"></Item>
                                <Item Key="SSLCAFile" ValueType="String"></Item>
                                <Item Key="SSLCADir" ValueType="String"></Item>
                                <Item Key="SSLVerifyHostname" ValueType="Checkbox">1</Item>
                                <Item Key="SSLVerifyMode" ValueType="Checkbox">1</Item>
                            </Hash>
                        </Item>
                    </Hash>
                </Item>
            </Hash>
        </Value>
 </Setting>

